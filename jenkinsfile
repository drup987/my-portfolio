pipeline {
    agent any

    environment {
        SSH_CRED = 'node-pipeline-key'       // Jenkins credential ID
        SERVER_IP = '172.31.44.98'          // Target Deploy EC2 IP
        REMOTE_USER = 'ubuntu'
        WEB_DIR = '/var/www/html'
    }

    stages {
        stage('Clone Repo') {
            steps {
                git url: 'https://github.com/drup987/portfolio.git', branch: 'main'
            }
        }

        stage('Deploy to Web Server') {
            steps {
                sshagent(credentials: ["${SSH_CRED}"]) {
                    sh '''
                        echo "Ensuring web directory exists and cleaning old files..."
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} "sudo mkdir -p ${WEB_DIR} && sudo rm -rf ${WEB_DIR}/*"

                        echo "Creating temp upload directory..."
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} "mkdir -p /tmp/portfolio"

                        echo "Uploading portfolio files..."
                        scp -o StrictHostKeyChecking=no -r index.html css js images Drup_Aherwar_Resume.pdf ${REMOTE_USER}@${SERVER_IP}:/tmp/portfolio/

                        echo "Deploying to web directory..."
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} "sudo cp -r /tmp/portfolio/* ${WEB_DIR}/ && sudo rm -rf /tmp/portfolio"
                    '''
                }
            }
        }
    }
}
