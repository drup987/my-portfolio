pipeline {
    agent any

    environment {
        SSH_CRED = 'node-pipeline-key'       // Jenkins credential ID
        SERVER_IP = '172.31.44.98'          // Target Deploy EC2 IP
        REMOTE_USER = 'ubuntu'
        WEB_DIR = '/var/www/html'
    }

    stages {
        stage('Clone Repo') {
            steps {
                git url: 'https://github.com/drup987/my-portfolio.git', branch: 'main'
            }
        }

        stage('Deploy to Web Server') {
            steps {
                sshagent(credentials: ["${SSH_CRED}"]) {
                    sh '''
                        echo "Installing and starting Apache web server..."
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} "sudo apt update && sudo apt install -y apache2 && sudo systemctl enable --now apache2"

                        echo "Compressing portfolio files into portfolio.tar.gz..."
                        tar -czf portfolio.tar.gz index.html css js images Drup_Aherwar_Resume.pdf

                        echo "Uploading portfolio.tar.gz to target server..."
                        scp -o StrictHostKeyChecking=no portfolio.tar.gz ${REMOTE_USER}@${SERVER_IP}:/tmp/

                        echo "Extracting portfolio files to ${WEB_DIR}..."
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} "sudo rm -rf ${WEB_DIR}/* && sudo tar -xzf /tmp/portfolio.tar.gz -C ${WEB_DIR}/ && rm -f /tmp/portfolio.tar.gz"

                        echo "Cleaning up local archive..."
                        rm -f portfolio.tar.gz
                    '''
                }
            }
        }
    }
}